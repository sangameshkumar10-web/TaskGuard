# TaskGuard Frontend Environment Variables
# Copy this file to .env.local for local development or .env.production for production

# API Base URL
# Local development: uses Vite proxy to http://127.0.0.1:8000 (default: "/api")
# Production (Vercel): Set to your deployed backend URL (e.g., "https://api.yourapp.com")
# VITE_API_BASE_URL=https://api.yourapp.com

# For local development with backend running on different port:
# VITE_API_BASE_URL=http://127.0.0.1:8000